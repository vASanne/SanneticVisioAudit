# Copy to VisioAudit-Infra/.env to override the development fallbacks in compose.yaml.
# Compose reads this file automatically for interpolation. Do not commit the copy.

POSTGRES_USER=visio
POSTGRES_PASSWORD=REDACTED
POSTGRES_DB=visioaudit

MINIO_ROOT_USER=visioaudit
MINIO_ROOT_PASSWORD=REDACTED

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional. Without a key, Core Web Vitals (T09) is omitted from the score.
# PAGESPEED_API_KEY=

# Local defaults match compose.yaml. Override before any shared use.
AUTH_SECRET=REDACTED
AGENCY_EMAIL=admin@sannetic.local
AGENCY_PASSWORD=REDACTED
AGENCY_NAME=Sannetic

# Optional Google Search Console bearer token (or store per client in settings).
# GSC_ACCESS_TOKEN=

# Optional LLM advisory (not part of the score).
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini

