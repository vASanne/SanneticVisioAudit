# Copy to VisioAudit-Infra/.env and replace every placeholder.
# Compose reads that file for interpolation. Do not commit the copy.
# Generate each secret with: openssl rand -hex 32
# Use URL-safe characters in REDIS_PASSWORD and POSTGRES_PASSWORD.

POSTGRES_USER=visio
POSTGRES_PASSWORD=replace-with-a-unique-password
POSTGRES_DB=visioaudit

REDIS_PASSWORD=replace-with-a-url-safe-password

MINIO_ROOT_USER=visioaudit
MINIO_ROOT_PASSWORD=replace-with-a-unique-password

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Required. AUTH_SECRET must be at least 32 characters.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Session cookie. true behind HTTPS. The development override forces false for local HTTP.
# COOKIE_SAMESITE is lax or strict. The dashboard and the API must share a site
# (both 127.0.0.1, or both names under the same registrable domain).
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
AGENCY_EMAIL=admin@example.com
AGENCY_PASSWORD=replace-with-a-unique-password
AGENCY_NAME=Agency

# Optional. Without a key, Core Web Vitals (T09) is omitted from the score.
# PAGESPEED_API_KEY=

# Optional Google Search Console bearer token (or store it per client).
# GSC_ACCESS_TOKEN=

# Optional LLM advisory (not part of the score). The URL must be public https.
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
