# Copy to VisioAudit-Infra/.env. Compose refuses to start when a required value is empty.
# Generate each secret with: openssl rand -hex 32
# REDIS_PASSWORD and POSTGRES_PASSWORD must be URL-safe hex. No spaces or #.
# Do not commit the copy.

# Required. Database role and database name.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Required. Redis AUTH password. URL-safe, no spaces or #.
REDIS_PASSWORD=

# Required. MinIO root credentials. Password must be at least 8 characters.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Public origin. Dashboard and API share this host. No path and no trailing slash.
# The browser calls ${NEXT_PUBLIC_API_URL}/api/v1/...
NEXT_PUBLIC_API_URL=https://visioaudit.va
# Browser origin allowed to call the API. One origin. Never *.
CORS_ORIGINS=https://visioaudit.va

# Required. At least 32 characters.
AUTH_SECRET=
# Required. First API start creates this agency admin if the user does not exist.
AGENCY_EMAIL=
AGENCY_PASSWORD=
# Display name for that account. Empty uses Agentur.
AGENCY_NAME=

# Session cookie. true behind https://visioaudit.va. compose.dev.yaml forces false for local HTTP.
# COOKIE_SAMESITE is lax or strict. Dashboard and API must share one site.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Required in production. Comma-separated IPs or IPv4 CIDRs. No spaces. Never *.
# This is the TCP source the containers see for Caddy, often the Docker bridge gateway.
TRUSTED_PROXY_IPS=

# Leave empty. Caddy keeps the /api prefix and the API is already mounted at /api/v1.
# Set /api only when a proxy strips that prefix before the request reaches the API.
ROOT_PATH=

# Published ports. Only the API and the frontend are published.
API_BIND_ADDRESS=0.0.0.0
API_PUBLISH_PORT=8000
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PUBLISH_PORT=3000

# Optional. Without a key, Core Web Vitals (T09) is omitted from the score.
PAGESPEED_API_KEY=

# Optional Google Search Console bearer token, or store it per client.
GSC_ACCESS_TOKEN=

# Optional LLM advisory. Not part of the score. The URL must be public https.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Optional crawl caps.
MAX_PAGES_CAP=500
MAX_LINK_PROBES=200
